# ============================================================
# Silent Reckoning·1987 — Git 忽略规则
# ============================================================

# --- Godot 编辑器缓存（不应入库） ---
.godot/
**/.godot/

# --- Godot 导入缓存 ---
*.import
*.uid.bak

# --- 本地测试隔离目录（APPDATA 重定向, 不入库） ---
.godot-user/

# --- 操作系统/编辑器杂项 ---
.DS_Store
Thumbs.db
*.swp
*.swo

# --- 构建/导出产物 ---
export/
build/
*.exe
*.pck
*.zip

# --- 日志/临时 ---
*.log
tmp/
